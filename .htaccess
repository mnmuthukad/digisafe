# DigiSafe Keralam — static site, clean URLs, fast caching (Apache / LiteSpeed)
#   /  /about  /learn  /team  /login  /register  /dashboard   English
#   /ml/  /ml/about  /ml/learn  /ml/team   Malayalam
# Works from the domain root or a project subdirectory (for example /digisafe/).

Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8

RewriteEngine On

# Never serve source/data files
RewriteRule \.(json|md|txt)$ - [R=404,L,NC]

# old /students -> /learn
RewriteRule ^students(\.[a-zA-Z0-9]+)?/?$ learn [R=301,L]

# trailing slash off
RewriteRule ^(ml/)?(learn|team|about|login|register|dashboard)/$ $1$2 [R=301,L]

# serve clean address from the real file
RewriteRule ^(ml/)?(learn|team|about|login|register|dashboard)$ $1$2.html [L]

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml font/woff
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript image/svg+xml
</IfModule>

# Caching: assets are fingerprinted (?v=) or rarely change; HTML revalidates
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff .woff
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js|webp|woff|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
